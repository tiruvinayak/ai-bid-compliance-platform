# Backend environment variables (placeholders only — NEVER commit real credentials).
# Copy to .env and fill values locally if needed; .env must stay untracked.

# --- Phase 5A: External Government Verification Providers ---
# Providers stay UNAVAILABLE while enabled=false or base-url/api-key are empty.
# mode: production | sandbox   (sandbox results are labelled SANDBOX, never production VERIFIED)

GST_VERIFICATION_ENABLED=false
GST_VERIFICATION_BASE_URL=
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_MODE=production

PAN_VERIFICATION_ENABLED=false
PAN_VERIFICATION_BASE_URL=
PAN_VERIFICATION_API_KEY=
PAN_VERIFICATION_MODE=production

MCA_VERIFICATION_ENABLED=false
MCA_VERIFICATION_BASE_URL=
MCA_VERIFICATION_API_KEY=
MCA_VERIFICATION_MODE=production

EPFO_ESIC_VERIFICATION_ENABLED=false
EPFO_ESIC_VERIFICATION_BASE_URL=
EPFO_ESIC_VERIFICATION_API_KEY=
EPFO_ESIC_VERIFICATION_MODE=production

DIGILOCKER_VERIFICATION_ENABLED=false
DIGILOCKER_VERIFICATION_BASE_URL=
DIGILOCKER_VERIFICATION_API_KEY=
DIGILOCKER_VERIFICATION_MODE=production

VERIFICATION_CONNECT_TIMEOUT_MS=3000
VERIFICATION_READ_TIMEOUT_MS=5000

# --- Existing (defaults live in application.yml; override without committing secrets) ---
# APP_JWT_SECRET=
# AI_SERVICE_BASE_URL=http://localhost:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173
