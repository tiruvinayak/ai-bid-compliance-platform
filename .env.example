# ==============================================================================
# SIH Bid Compliance Platform - Environment Variable Template
# Copy this file to .env before starting containers: cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=sih_bid_compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Spring Boot Backend Configuration
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sih_bid_compliance
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# JWT Authentication Secret (Must be a long, secure random string)
APP_JWT_SECRET=CHANGE_ME_JWT_SECRET_USE_A_LONG_RANDOM_STRING

# Storage & Network Configuration
UPLOAD_DIR=/app/uploads
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Spring Boot -> FastAPI Microservice URL (Internal Docker network hostname)
AI_SERVICE_BASE_URL=http://ai-service:8000

# Python AI Service -> PostgreSQL Connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sih_bid_compliance
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Python AI Service -> Ollama Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional: Cloud LLM API Keys (If switching from local Ollama to Gemini/OpenAI)
# LLM_API_KEY=
